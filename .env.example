# Copy to .env and fill values locally. Never commit .env.
YOUTUBE_API_KEY=
GOOGLE_DRIVE_API_KEY=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://127.0.0.1/login/discord/callback
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Local preview uses SQLite; VM uses MySQL after migration and activation.
DB_BACKEND=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=luminus_db
ADMIN_NICKNAME=
ADMIN_DRIVE_ALLOWED_EMAIL=
STAFF_NICKNAMES=
DEV_NICKNAMES=
DEV_EMAIL=
STAFF_ROLE_LABELS=
LISTEN_ADDR=127.0.0.1:80
SITE_HOST=localhost
ADMIN_HOSTNAME=admin.localhost
COOKIE_SECURE=false
COOKIE_DOMAIN=
